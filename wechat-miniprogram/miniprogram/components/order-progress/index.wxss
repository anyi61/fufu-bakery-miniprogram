.flow{display:flex;justify-content:space-between;margin:32rpx 0}.step{position:relative;flex:1;text-align:center;color:#aaa49b;font-size:18rpx}.step::before{content:"";position:absolute;left:0;right:0;top:11rpx;height:2rpx;background:#ded8ce}.step:first-child::before{left:50%}.step:last-child::before{right:50%}.step .dot{position:relative;z-index:1;width:20rpx;height:20rpx;margin:0 auto 10rpx;display:block;border-radius:50%;background:#d7d1c8}.step text{display:block}.step.done{color:#d85f2b}.step.done::before,.step.done .dot{background:#d85f2b}
