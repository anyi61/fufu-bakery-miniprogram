:host{box-sizing:border-box;display:block;width:100%;overflow:hidden}.product{box-sizing:border-box;width:100%;min-width:0;display:flex;gap:24rpx;padding:26rpx 0;overflow:hidden;border-bottom:1rpx solid #eee7dc}.photo{position:relative;width:190rpx;height:190rpx;flex:0 0 190rpx}.product-image{width:100%;height:100%;border-radius:20rpx;background:#eee}.product-tag{position:absolute;left:10rpx;top:10rpx;padding:7rpx 12rpx;border-radius:99rpx;background:#d85f2b;color:#fff;font-size:18rpx}.sold-mask{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;border-radius:20rpx;background:rgba(35,32,28,.55);color:#fff;font-weight:700}.copy{position:relative;min-width:0;flex:1;display:flex;flex-direction:column;justify-content:space-between}.title,.subtitle,.stock{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.title{font-family:Georgia,"Songti SC",serif;font-size:31rpx;font-weight:700}.subtitle{margin-top:8rpx;color:#8f887e;font-size:21rpx}.stock{margin-top:12rpx;color:#54816b;font-size:21rpx}.stock.low{color:#d85f2b}.foot{min-height:58rpx;display:flex;align-items:center}.price{font-family:Georgia,serif;font-size:34rpx;font-weight:700}.add,.step-button{box-sizing:border-box;margin:0;padding:0;display:flex;align-items:center;justify-content:center;border-radius:999rpx;background:#d85f2b;color:#fff;line-height:1}.add{position:absolute;right:0;bottom:0;width:58rpx;min-width:58rpx;max-width:58rpx;height:58rpx;font-size:38rpx}.step{position:absolute;right:0;bottom:5rpx;display:flex;align-items:center;gap:18rpx}.step-button{width:48rpx;min-width:48rpx;max-width:48rpx;height:48rpx;flex:0 0 48rpx;font-size:28rpx}.step-remove{border:1rpx solid #d9d1c5;background:#fff;color:#4b4741}.sold{opacity:.62}
