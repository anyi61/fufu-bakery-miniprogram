.product{display:grid;grid-template-columns:190rpx 1fr;gap:24rpx;padding:26rpx 0;border-bottom:1rpx solid #eee7dc}.photo{position:relative;width:190rpx;height:190rpx}.photo image{width:100%;height:100%;border-radius:20rpx;background:#eee}.photo>text{position:absolute;left:10rpx;top:10rpx;padding:7rpx 12rpx;border-radius:99rpx;background:#d85f2b;color:#fff;font-size:18rpx}.sold-mask{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;border-radius:20rpx;background:rgba(35,32,28,.55);color:#fff;font-weight:700}.copy{min-width:0;display:flex;flex-direction:column;justify-content:space-between}.title,.subtitle,.stock{display:block}.title{font-family:Georgia,"Songti SC",serif;font-size:31rpx;font-weight:700}.subtitle{margin-top:8rpx;color:#8f887e;font-size:21rpx}.stock{margin-top:12rpx;color:#54816b;font-size:21rpx}.stock.low{color:#d85f2b}.foot{display:flex;align-items:center;justify-content:space-between}.price{font-family:Georgia,serif;font-size:34rpx;font-weight:700}.add,.step button{padding:0;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#d85f2b;color:#fff}.add{width:58rpx;height:58rpx;font-size:38rpx}.step{display:flex;align-items:center;gap:18rpx}.step button{width:48rpx;height:48rpx;font-size:28rpx}.step button:first-child{border:1rpx solid #d9d1c5;background:#fff;color:#4b4741}.sold{opacity:.62}
