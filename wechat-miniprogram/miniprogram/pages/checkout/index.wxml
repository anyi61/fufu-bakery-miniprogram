<view class="checkout page safe-bottom"><view class="card section"><view class="icon">⌖</view><view><text class="label">自提门店</text><text class="value">小雨面包 · 首店</text><text class="detail">正式地址待配置</text></view></view><view class="card section"><view class="icon">◷</view><view><text class="label">预约取货时间</text><text class="value">今天 {{slot.displayTime}}</text><text class="detail">当前余 {{slot.availableCapacity}} 单可约</text></view></view><view class="card section"><view class="icon">♙</view><view><text class="label">取货人</text><text class="value">张女士 · 138 **** 0826</text><text class="detail">仅用于取货通知与订单联系</text></view></view>
  <view class="card goods"><text class="goods-title">商品明细</text><view wx:for="{{lines}}" wx:key="id" class="line"><image src="{{item.imageUrl}}" mode="aspectFill"></image><view><text>{{item.name}}</text><text class="detail">{{item.subtitle}}</text><text class="price">¥{{item.price}}</text></view><text>× {{item.quantity}}</text></view></view>
  <view class="card bill"><view><text>商品小计</text><text>¥{{subtotal}}</text></view><view><text>包装费</text><text>¥{{packageFee}}</text></view><view class="total"><text>合计</text><text>¥{{total}}</text></view></view>
  <view class="payment-note"><text>支付方式</text><text>微信支付（体验模式）</text></view><button class="primary submit" loading="{{paying}}" disabled="{{paying || !slot}}" bindtap="submit"><text>{{paying ? '正在锁定库存…' : '确认支付'}}</text><text>¥{{total}}</text></button><text class="agreement">提交即表示同意《用户协议》《退款规则》</text>
</view>
