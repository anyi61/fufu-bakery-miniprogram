.success{box-sizing:border-box;min-height:100vh;padding:calc(160rpx + env(safe-area-inset-top)) 50rpx 50rpx;text-align:center;background:#fffdf8}.check{width:130rpx;height:130rpx;margin:0 auto 36rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#287b59;color:#fff;font-size:68rpx}.title,.copy{display:block}.title{margin:12rpx 0;font-family:Georgia,"Songti SC",serif;font-size:54rpx;font-weight:700}.copy{color:#8d887e}.code{margin:48rpx 0;padding:30rpx}.code text{display:block}.code text:first-child{color:#918a81;font-size:21rpx}.code text:last-child{margin-top:12rpx;font-size:58rpx;font-weight:700;letter-spacing:10rpx}.merchant{margin-top:20rpx;background:transparent;color:#d85f2b;font-size:23rpx}
