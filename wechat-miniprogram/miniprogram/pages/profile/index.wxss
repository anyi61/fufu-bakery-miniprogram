.profile{padding:34rpx}.profile-head{padding:48rpx 8rpx;display:flex;align-items:center;gap:24rpx}.avatar{box-sizing:border-box;width:110rpx;min-width:110rpx;max-width:110rpx;height:110rpx;flex:0 0 110rpx;display:flex;align-items:center;justify-content:center;overflow:hidden;border-radius:55rpx;background:#d85f2b;color:#fff;font-size:42rpx}.avatar image{display:block;width:110rpx;height:110rpx;border-radius:55rpx}.profile-copy{min-width:0;flex:1}.profile-head text{display:block}.hello{margin-bottom:9rpx;overflow:hidden;font-size:35rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}.stats{padding:30rpx;display:grid;grid-template-columns:repeat(3,1fr)}.stats view{text-align:center;border-right:1rpx solid #eee5d9}.stats view:last-child{border:0}.stats text{display:block}.stats text:first-child{font-family:Georgia,serif;font-size:38rpx;font-weight:700}.stats text:last-child{margin-top:7rpx;color:#938b82;font-size:21rpx}.menu{margin-top:24rpx;padding:8rpx 0;overflow:hidden}.menu-row{position:relative;box-sizing:border-box;width:100%;height:96rpx;margin:0;padding:0 26rpx;display:flex;align-items:center;border-bottom:1rpx solid #eee6da;border-radius:0;background:transparent;color:#292621;text-align:left}.menu-row:last-child{border-bottom:0}.menu-icon{width:54rpx;flex:0 0 54rpx;color:#5e5952;font-size:29rpx;text-align:left}.menu-label{min-width:0;flex:1;font-size:28rpx}.menu-arrow{width:32rpx;flex:0 0 32rpx;color:#aaa198;font-size:38rpx;text-align:right}.contact-hit{position:absolute;z-index:2;left:0;right:0;top:0;bottom:0;width:auto;height:auto;margin:0;padding:0;opacity:0}.merchant-entry,.reset{margin-top:28rpx;color:#d85f2b;background:transparent;font-size:24rpx}.reset{color:#9a9289;font-size:21rpx}
