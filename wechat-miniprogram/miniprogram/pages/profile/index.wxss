.profile{padding:34rpx}.profile-head{padding:48rpx 8rpx;display:flex;align-items:center;gap:24rpx}.avatar{width:110rpx;height:110rpx;padding:0;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#d85f2b;color:#fff;font-size:42rpx}.avatar image{width:100%;height:100%;border-radius:50%}.profile-head text{display:block}.hello{margin-bottom:9rpx;font-size:35rpx;font-weight:700}.stats{padding:30rpx;display:grid;grid-template-columns:repeat(3,1fr)}.stats view{text-align:center;border-right:1rpx solid #eee5d9}.stats view:last-child{border:0}.stats text{display:block}.stats text:first-child{font-family:Georgia,serif;font-size:38rpx;font-weight:700}.stats text:last-child{margin-top:7rpx;color:#938b82;font-size:21rpx}.menu{margin-top:24rpx;padding:8rpx 26rpx}.menu button{height:96rpx;padding:0;display:grid;grid-template-columns:54rpx 1fr auto;align-items:center;border-bottom:1rpx solid #eee6da;background:transparent;text-align:left}.menu button:last-child{border:0}.menu button text:last-child{color:#aaa198;font-size:38rpx}.merchant-entry,.reset{margin-top:28rpx;color:#d85f2b;background:transparent;font-size:24rpx}.reset{color:#9a9289;font-size:21rpx}
