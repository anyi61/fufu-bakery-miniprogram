.orders{padding:28rpx}.orders-head{padding:28rpx 8rpx}.orders-head text{display:block}.orders-head text:last-child{margin-top:8rpx;font-family:Georgia,"Songti SC",serif;font-size:50rpx;font-weight:700}.order-card{padding:30rpx}.top{display:flex;justify-content:space-between;font-size:23rpx}.top text:first-child{font-weight:700}.top text:last-child{color:#d85f2b;font-weight:700}.goods{padding:28rpx 0;display:flex;align-items:center;gap:24rpx;border-top:1rpx solid #eee6db}.photos{display:flex}.photos image{width:88rpx;height:88rpx;margin-right:-18rpx;border:5rpx solid #fffdf8;border-radius:16rpx}.goods text{display:block}.goods text:first-child{font-weight:700}.goods text:last-child{margin-top:8rpx;color:#938c83;font-size:22rpx}.pickup{padding:30rpx;text-align:center;border-radius:20rpx;background:#f0e9df}.pickup text{display:block}.pickup text:first-child{color:#8d887e;font-size:20rpx}.pickup text:nth-child(2){margin:10rpx 0;font-size:58rpx;font-weight:700;letter-spacing:9rpx}.pickup text:last-child{color:#6f6961;font-size:21rpx}.actions{margin-top:24rpx;display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.actions button{height:78rpx;display:flex;align-items:center;justify-content:center;border:1rpx solid #e0d7ca;border-radius:14rpx;background:#fff;color:#5b554d;font-size:22rpx}
