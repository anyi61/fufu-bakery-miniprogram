<view class="page orders safe-bottom"><view wx:if="{{loading}}" class="empty">正在同步订单…</view><view wx:elif="{{!order}}" class="empty"><view class="empty-icon">▤</view><text class="empty-title">还没有订单</text><text class="empty-copy">挑几款今天出炉的面包吧</text><button class="primary" bindtap="orderFood">去点单</button></view>
  <view wx:else><view class="orders-head"><text class="eyebrow">MY ORDER</text><text>我的订单</text></view><view class="order-card card"><view class="top"><text>预约自提 · #{{order.displayNumber}}</text><text>{{order.statusLabel}}</text></view><order-progress status="{{order.status}}"></order-progress><view class="goods"><view class="photos"><image wx:for="{{order.items}}" wx:key="productId" wx:if="{{index < 2}}" src="{{item.imageUrl}}" mode="aspectFill"></image></view><view><text>{{order.items[0].productName}}{{order.items.length > 1 ? '等' : ''}}</text><text>共 {{itemCount}} 件 · ¥{{total}}</text></view></view><view class="pickup"><text>到店出示取餐码</text><text>{{order.pickupCodeDisplay}}</text><text wx:if="{{order.status === 'ready'}}">面包已备妥，可以来取啦</text><text wx:elif="{{order.status === 'completed'}}">已于门店完成核销</text><text wx:else>预计今天 {{order.slot.startsAt}} 可取</text></view><view class="actions"><button open-type="contact">联系门店</button><button bindtap="merchant">门店处理 Demo</button></view></view></view>
</view>
