.merchant{padding:30rpx}.merchant-head{padding:20rpx 6rpx 34rpx}.merchant-head text{display:block}.merchant-head .title{margin:8rpx 0;font-family:Georgia,"Songti SC",serif;font-size:54rpx;font-weight:700}.tabs{margin-bottom:26rpx;display:grid;grid-template-columns:repeat(3,1fr);gap:8rpx;padding:8rpx;border-radius:18rpx;background:#e9e1d6}.tabs button{height:68rpx;border-radius:13rpx;background:transparent;color:#756e65;font-size:22rpx}.tabs button.active{background:#292621;color:#fff}.kpis{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.kpis view{padding:24rpx}.kpis text{display:block}.kpis text:nth-child(1),.kpis text:nth-child(3){color:#918a81;font-size:20rpx}.kpis text:nth-child(2){margin:9rpx 0;font-family:Georgia,serif;font-size:43rpx;font-weight:700}.order{margin-top:20rpx;padding:26rpx}.order-top{display:flex;justify-content:space-between}.order-top text{display:block}.number{margin:12rpx 0 6rpx;font-size:30rpx;font-weight:700}.status{color:#d85f2b;font-weight:700}.customer,.items,.amount{margin-top:22rpx;padding:20rpx 0;border-top:1rpx solid #eee5d8}.customer text{display:block}.customer text:first-child,.amount text:first-child{color:#938c83;font-size:20rpx}.customer text:nth-child(2){margin:7rpx 0;font-weight:700}.customer text:last-child{color:#777068;font-size:21rpx}.items>view,.amount{display:flex;justify-content:space-between}.items>view{padding:7rpx 0}.amount text:last-child{font-size:38rpx;font-weight:700}.order .primary{margin-top:24rpx}.verify{margin-top:24rpx;display:grid;grid-template-columns:1fr 230rpx;gap:12rpx}.verify input{padding:0 20rpx;border:1rpx solid #ddd3c6;border-radius:14rpx;background:#fff}.completed{margin-top:24rpx;padding:24rpx;text-align:center;color:#287b59;font-weight:700}.batch{padding:30rpx}.batch text{display:block}.batch-time{margin:10rpx 0;font-family:Georgia,serif;font-size:53rpx;font-weight:700}.production{margin-top:20rpx;padding:10rpx 24rpx}.production>view{padding:20rpx 0;display:grid;grid-template-columns:50rpx 82rpx 1fr auto;gap:16rpx;align-items:center;border-bottom:1rpx solid #eee5d9}.production image{width:82rpx;height:82rpx;border-radius:12rpx}.production text{display:block}.production .muted{margin-top:4rpx;font-size:18rpx}.seq{color:#d85f2b}.quantity{font-weight:700}.capacity{margin-top:20rpx;padding:28rpx}.section-title{display:block;margin-bottom:18rpx;font-size:30rpx;font-weight:700}.capacity>view{padding:10rpx 0;display:grid;grid-template-columns:150rpx 1fr 72rpx;gap:14rpx;align-items:center;font-size:20rpx}.inventory-title{padding:16rpx 4rpx 24rpx}.inventory-title text{display:block}.inventory-title text:first-child{font-size:35rpx;font-weight:700}.inventory-title text:last-child{margin-top:6rpx}.inventory{padding:10rpx 24rpx}.inventory-row{padding:20rpx 0;display:grid;grid-template-columns:86rpx 1fr auto;gap:18rpx;align-items:center;border-bottom:1rpx solid #eee5d8}.inventory-row image{width:86rpx;height:86rpx;border-radius:13rpx}.inventory-row text{display:block}.inventory-row text:first-child{font-weight:700}.inventory-row .muted{margin-top:7rpx;font-size:18rpx}.inventory-row button{padding:12rpx 16rpx;border:1rpx solid #ddd3c6;background:#fff;color:#d85f2b;font-size:19rpx}
