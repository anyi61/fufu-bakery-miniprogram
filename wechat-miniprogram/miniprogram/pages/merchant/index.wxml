<view class="page merchant safe-bottom"><view class="merchant-head"><text class="eyebrow">STORE CONSOLE</text><text class="title">门店工作台</text><text class="muted">小雨面包 · 首店</text></view><view class="tabs"><button class="{{tab === 'orders' ? 'active' : ''}}" data-tab="orders" bindtap="tab">订单中心</button><button class="{{tab === 'production' ? 'active' : ''}}" data-tab="production" bindtap="tab">生产看板</button><button class="{{tab === 'inventory' ? 'active' : ''}}" data-tab="inventory" bindtap="tab">今日库存</button></view>
  <view wx:if="{{!authorized}}" class="empty card"><view class="empty-icon">♙</view><text class="empty-title">需要门店员工权限</text><text class="empty-copy">请让 owner 将当前微信 openid 加入 staff 集合</text></view><view wx:elif="{{tab === 'orders'}}"><view class="kpis"><view class="card"><text>今日实收</text><text>¥{{order ? total : '824'}}</text><text>预约自提 100%</text></view><view class="card"><text>待处理</text><text>{{order && order.status === 'pending_acceptance' ? 1 : 0}}</text><text>请及时接单</text></view></view><view wx:if="{{!order}}" class="empty card"><view class="empty-icon">◎</view><text class="empty-title">等待新订单</text><text class="empty-copy">请先从顾客端完成一次下单</text></view><view wx:else class="order card"><view class="order-top"><view><text class="pill">预约自提</text><text class="number">#{{order.displayNumber}}</text><text class="muted">取货 {{order.slot.startsAt}}–{{order.slot.endsAt}}</text></view><text class="status">{{order.statusLabel}}</text></view><view class="customer"><text>取货人</text><text>{{order.customerName}} · {{order.customerPhoneMasked}}</text><text>备注：{{order.remark || '无'}}</text></view><view class="items"><view wx:for="{{order.items}}" wx:key="productId"><text>{{item.productName}}</text><text>× {{item.quantity}}</text></view></view><view class="amount"><text>实付金额</text><text>¥{{total}}</text></view><button wx:if="{{nextStatus}}" class="primary" loading="{{busy}}" data-status="{{nextStatus}}" bindtap="advance">{{nextLabel}} →</button><view wx:elif="{{order.status === 'ready'}}" class="verify"><input value="{{verifyCode}}" bindinput="inputCode" placeholder="输入动态取餐码"></input><button class="primary" loading="{{busy}}" bindtap="verify">核销取货</button></view><view wx:else class="completed">✓ 已完成核销</view></view></view>
  <view wx:elif="{{tab === 'production'}}"><view class="batch card"><text class="eyebrow">NEXT PICKUP WINDOW</text><text class="batch-time">{{slots[0].displayTime || '暂无'}}</text><text class="muted">已支付订单自动计入生产批次</text></view><view class="production card"><view wx:for="{{products}}" wx:key="id" wx:if="{{index < 4}}"><text class="seq">0{{index + 1}}</text><image src="{{item.imageUrl}}" mode="aspectFill"></image><view><text>{{item.name}}</text><text class="muted">{{item.subtitle}}</text></view><text class="quantity">{{item.soldStock}} 份</text></view></view><view class="capacity card"><text class="section-title">时间段负载</text><view wx:for="{{slots}}" wx:key="id"><text>{{item.displayTime}}</text><progress percent="{{(item.paidCount + item.reservedCount) / item.capacity * 100}}" activeColor="#d85f2b" stroke-width="5"></progress><text>{{item.paidCount + item.reservedCount}}/{{item.capacity}}</text></view></view></view>
  <view wx:else><view class="inventory-title"><text>库存与售罄管理</text><text class="muted">售罄立即同步顾客端</text></view><view class="inventory card"><view wx:for="{{products}}" wx:key="id" class="inventory-row"><image src="{{item.imageUrl}}" mode="aspectFill"></image><view><text>{{item.name}}</text><text class="muted">计划 {{item.plannedStock}} · 已售 {{item.soldStock}} · 剩余 {{item.availableStock}}</text></view><button disabled="{{busy}}" data-id="{{item.id}}" bindtap="toggle">{{item.isSoldOut ? '恢复销售' : '临时售罄'}}</button></view></view></view>
</view>
