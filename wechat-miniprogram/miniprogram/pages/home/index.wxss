.home{padding-bottom:180rpx}.hero{padding:0 34rpx 54rpx;background:linear-gradient(145deg,#f2eadf,#faf7ef)}.status-space{height:calc(32rpx + env(safe-area-inset-top))}.hero-copy{margin-top:58rpx}.headline,.subline{display:block}.headline{margin:16rpx 0 18rpx;white-space:pre-line;font-family:Georgia,"Songti SC",serif;font-size:68rpx;line-height:1.1;font-weight:700}.subline{color:#777168;font-size:23rpx}.store-card{margin:-28rpx 26rpx 20rpx;padding:28rpx;display:flex;align-items:center;justify-content:space-between}.store-card text{display:block}.store-name{margin:14rpx 0 7rpx;font-size:30rpx;font-weight:700}.store-meta{color:#8d887e;font-size:21rpx}.arrow{font-size:50rpx;color:#a69f95}.slot{width:calc(100% - 52rpx);height:auto;margin:0 26rpx;padding:26rpx 28rpx;display:flex;justify-content:space-between;text-align:left}.slot text{display:block}.slot-time{margin-top:8rpx;font-size:31rpx;font-weight:700}.slot-right{text-align:right;color:#d85f2b;font-size:21rpx}.slot-right text+text{margin-top:8rpx}.fresh{margin:22rpx 26rpx;padding:19rpx 24rpx;display:flex;gap:20rpx;border-radius:14rpx;background:#e8efe8;color:#4c725f;font-size:21rpx}.fresh text:first-child{font-weight:700}.categories{white-space:nowrap}.category-row{padding:10rpx 26rpx 18rpx;display:flex;gap:12rpx}.category-row button{flex:none;padding:14rpx 26rpx;border-radius:99rpx;background:#ebe3d8;color:#787168;font-size:22rpx}.category-row button.active{background:#292621;color:#fff}.menu{margin-top:4rpx;padding:26rpx;background:#fffdf8}.section-head{display:flex;align-items:flex-end;justify-content:space-between;padding:4rpx 0 12rpx;color:#9a938a;font-size:21rpx}.section-head text{display:block}.section-title{font-family:Georgia,"Songti SC",serif;color:#292621;font-size:38rpx;font-weight:700}.section-sub{margin-top:6rpx}.loading{padding:70rpx;text-align:center;color:#999}.cart-bar{position:fixed;z-index:20;left:24rpx;right:24rpx;bottom:calc(28rpx + env(safe-area-inset-bottom));height:102rpx;padding:0 18rpx;display:grid;grid-template-columns:66rpx 1fr auto;align-items:center;border-radius:24rpx;background:#292621;color:#fff;box-shadow:0 18rpx 50rpx rgba(0,0,0,.28);text-align:left}.bag{position:relative;font-size:42rpx}.bag .badge{position:absolute;right:4rpx;top:-8rpx;min-width:30rpx;height:30rpx;padding:0 4rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#d85f2b;font-size:18rpx;font-style:normal}.cart-bar text{display:block}.cart-bar>view:nth-child(2){font-size:19rpx;color:#bdb7ae}.cart-price{margin-top:3rpx;color:#fff;font-size:30rpx;font-weight:700}.go{padding:20rpx 26rpx;border-radius:14rpx;background:#d85f2b;font-weight:700}
