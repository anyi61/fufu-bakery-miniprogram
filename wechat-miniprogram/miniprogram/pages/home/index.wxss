.home {
  padding-bottom: 220rpx;
}

.hero {
  padding: 0 34rpx 54rpx;
  background: linear-gradient(145deg, #f2eadf, #faf7ef);
}

.status-space {
  height: calc(32rpx + env(safe-area-inset-top));
}

.hero-copy {
  margin-top: 58rpx;
}

.headline,
.subline {
  display: block;
}

.headline {
  margin: 16rpx 0 18rpx;
  white-space: pre-line;
  font-family: Georgia, "Songti SC", serif;
  font-size: 68rpx;
  line-height: 1.1;
  font-weight: 700;
}

.subline {
  color: #777168;
  font-size: 23rpx;
}

.fresh {
  margin: 22rpx 26rpx;
  padding: 19rpx 24rpx;
  display: flex;
  gap: 20rpx;
  border-radius: 14rpx;
  background: #e8efe8;
  color: #4c725f;
  font-size: 21rpx;
}

.fresh text:first-child {
  font-weight: 700;
}

.menu-layout {
  display: flex;
  align-items: stretch;
  min-height: 820rpx;
  overflow: hidden;
  border-top: 1rpx solid #eee7dc;
  background: #fffdf8;
}

.category-panel {
  box-sizing: border-box;
  width: 166rpx;
  flex: 0 0 166rpx;
  overflow: hidden;
  background: #f1eee9;
}

.category-list {
  box-sizing: border-box;
  width: 166rpx;
  padding: 14rpx 0 220rpx;
}

.category-item {
  position: relative;
  box-sizing: border-box;
  width: 166rpx;
  min-height: 108rpx;
  padding: 18rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: transparent;
  color: #777168;
  font-size: 24rpx;
  line-height: 1.3;
  text-align: center;
}

.category-item.active {
  background: #fffdf8;
  color: #292621;
  font-weight: 700;
}

.category-marker {
  position: absolute;
  left: 0;
  top: 28rpx;
  width: 7rpx;
  height: 52rpx;
  border-radius: 0 8rpx 8rpx 0;
  background: #d85f2b;
}

.category-icon {
  margin-bottom: 5rpx;
  font-size: 31rpx;
  line-height: 1;
}

.category-label {
  display: block;
  width: 146rpx;
  overflow: hidden;
  text-align: center;
  white-space: nowrap;
}

.menu {
  box-sizing: border-box;
  width: calc(100% - 166rpx);
  min-width: 0;
  flex: 1;
  overflow: hidden;
  padding: 26rpx 24rpx;
  background: #fffdf8;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 4rpx 0 12rpx;
  color: #9a938a;
  font-size: 20rpx;
}

.section-head view {
  min-width: 0;
}

.section-head text {
  display: block;
}

.section-title {
  overflow: hidden;
  font-family: Georgia, "Songti SC", serif;
  color: #292621;
  font-size: 34rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.section-sub {
  margin-top: 6rpx;
  white-space: nowrap;
}

.loading {
  padding: 70rpx 10rpx;
  text-align: center;
  color: #999;
}

.cart-bar {
  position: fixed;
  z-index: 20;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  height: 104rpx;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: 88rpx minmax(0, 1fr) 194rpx;
  align-items: center;
  overflow: hidden;
  border: 1rpx solid #eee5da;
  border-radius: 52rpx;
  background: #fffdf8;
  color: #292621;
  box-shadow: 0 14rpx 40rpx rgba(52, 43, 32, 0.2);
}

.bag {
  position: relative;
  width: 88rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3ebdf;
  color: #d85f2b;
  font-size: 44rpx;
}

.bag .badge {
  position: absolute;
  right: 4rpx;
  top: 10rpx;
  min-width: 32rpx;
  height: 32rpx;
  box-sizing: border-box;
  padding: 0 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #fffdf8;
  border-radius: 16rpx;
  background: #c99155;
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
}

.cart-summary {
  min-width: 0;
  padding: 0 20rpx;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  white-space: nowrap;
}

.cart-summary text {
  display: block;
}

.cart-summary text:first-child {
  color: #292621;
  font-size: 27rpx;
  font-weight: 700;
}

.cart-price {
  font-family: Georgia, serif;
  color: #d85f2b;
  font-size: 36rpx;
  font-weight: 700;
}

.go {
  align-self: stretch;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 52rpx 52rpx 0;
  background: #d85f2b;
  color: #fff;
  font-size: 31rpx;
  font-weight: 700;
}
