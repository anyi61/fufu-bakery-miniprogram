  <view class="page home safe-bottom">
  <view class="hero"><view class="status-space"></view><rain-brand></rain-brand><view class="hero-copy"><text class="eyebrow">TODAY'S BAKE</text><text class="headline">今天出炉，\n今天带走。</text><text class="subline">当天制作 · 新鲜出炉 · 售完即止</text></view></view>
  <view class="fresh"><text>新鲜提示</text><text>下午第二炉可颂 15:30 出炉</text></view>
  <view class="menu-layout">
    <view class="category-panel">
      <view class="category-list">
        <view wx:for="{{categories}}" wx:key="*this" class="category-item {{category === item ? 'active' : ''}}" data-value="{{item}}" role="button" aria-label="{{item === '全部' ? '人气推荐' : item}}" bindtap="chooseCategory">
          <view wx:if="{{category === item}}" class="category-marker"></view>
          <text wx:if="{{item === '全部'}}" class="category-icon">🔥</text>
          <text class="category-label">{{item === '全部' ? '人气推荐' : item}}</text>
        </view>
      </view>
    </view>
    <view class="menu">
      <view class="section-head"><view><text class="section-title">{{category === '全部' ? '人气推荐' : category}}</text><text class="section-sub">当日制作 · 售完即止</text></view><text>{{visibleProducts.length}} 款</text></view>
      <view wx:if="{{loading}}" class="loading">正在同步今日菜单…</view>
      <product-card wx:for="{{visibleProducts}}" wx:key="id" product="{{item}}" quantity="{{cart[item.id] || 0}}" bind:add="add" bind:remove="remove"></product-card>
    </view>
  </view>
  <view wx:if="{{itemCount > 0}}" class="cart-bar" role="button" aria-label="已选 {{itemCount}} 件，预计到手 {{payable}} 元，去结算" bindtap="checkout">
    <view class="bag">▱<text class="badge">{{itemCount}}</text></view>
    <view class="cart-summary"><text>预计到手</text><text class="cart-price">¥{{payable}}</text></view>
    <view class="go">去结算</view>
  </view>
</view>
