page{--ink:#25231f;--muted:#8d887e;--paper:#fffdf8;--cream:#f6f1e8;--orange:#d85f2b;--green:#287b59;background:var(--cream);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx}button{font:inherit}button::after{border:0}.page{min-height:100vh}.safe-bottom{padding-bottom:calc(32rpx + env(safe-area-inset-bottom))}.eyebrow{font-size:20rpx;letter-spacing:4rpx;color:var(--orange);font-weight:700}.muted{color:var(--muted)}.money{font-family:Georgia,serif}.primary{height:92rpx;display:flex;align-items:center;justify-content:center;border-radius:18rpx;background:var(--orange);color:#fff;font-weight:700}.primary[disabled]{opacity:.45}.card{background:var(--paper);border-radius:24rpx;box-shadow:0 12rpx 38rpx rgba(76,57,35,.07)}.pill{display:inline-flex;align-items:center;padding:8rpx 16rpx;border-radius:99rpx;background:#f1e9dd;color:#8c5b3c;font-size:20rpx}.empty{padding:140rpx 50rpx;text-align:center}.empty-icon{width:110rpx;height:110rpx;margin:0 auto 28rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#ece4d8;font-size:48rpx;color:var(--orange)}.empty-title{font-size:34rpx;font-weight:700}.empty-copy{margin:14rpx 0 36rpx;color:var(--muted);font-size:24rpx}.toast-placeholder{height:1rpx}
